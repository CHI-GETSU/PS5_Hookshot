+static void finalize_report() {
+    static const bool on = getenv("RX_VK_FINALIZE_REPORT") && atoi(getenv("RX_VK_FINALIZE_REPORT")) != 0;
+    if (!on) return;
+    static auto last = std::chrono::steady_clock::now();
+    const auto now = std::chrono::steady_clock::now();
+    if (now - last < std::chrono::seconds(10)) return;
+    last = now;
+    std::vector<std::tuple<uint64_t, uint64_t, bool>> rows;
+    rows.reserve(textures.size());
+    uint64_t unknown = 0;
+    for (auto& kv : textures) {
+        const Texture* t = kv.second.get();
+        uint64_t mem = 0, size = 0;
+        if (!t->allocation || !vma_memory_of(t->allocation, &mem, &size)) { unknown++; continue; }   // (sparse: own chunks)
+        rows.emplace_back(mem, size, ps5_finalize_candidate(t->finalized_frame, t->last_frame));
+    }
+    const Ps5BlockTally k = ps5_block_tally(rows.begin(), rows.end());
+    logf("vk: finalize report: last 10 s %llu textures finalized (%llu rendered), %llu MB; now %llu finalized and unused "
+         "since, %llu MB; %llu memory blocks hold textures, %llu of them hold only those (%llu MB) and would be given back whole; "
+         "%llu textures without a VMA allocation", (unsigned long long)fin_n, (unsigned long long)fin_rendered_n,
+         (unsigned long long)(fin_bytes >> 20), (unsigned long long)k.cand_n, (unsigned long long)(k.cand_bytes >> 20),
+         (unsigned long long)k.blocks, (unsigned long long)k.whole,
+         (unsigned long long)(k.whole_bytes >> 20), (unsigned long long)unknown);
+    fin_n = fin_bytes = fin_rendered_n = 0;
+}
