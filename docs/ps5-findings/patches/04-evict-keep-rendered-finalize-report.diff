+/* PS5: (measure, RX_VK_POOL_REPORT=1; called every 10 s by the title) how full
+   VMA's blocks are: the 128 MB images pool, then each memory type (blocks, what is allocated in them, the largest unused
+   range). Read only (vmaCalculate*Statistics take VMA's own locks); nothing it reads decides anything */
+extern "C" void vma_pool_report_ps5() {
+    if (!vma) return;
+    char line[1536];
+    int n = snprintf(line, sizeof line, "vk: pool report:");
+    if (image_pool) {
+        VmaDetailedStatistics p{};
+        vmaCalculatePoolStatistics(vma, image_pool, &p);
+        const uint64_t bb = p.statistics.blockBytes, ab = p.statistics.allocationBytes;
+        n += snprintf(line + n, sizeof line - n, " images pool %u blocks %llu MiB, %u allocations %llu MiB (%llu%% full), "
+                      "largest hole %llu MiB, %u holes;", p.statistics.blockCount, (unsigned long long)(bb >> 20),
+                      p.statistics.allocationCount, (unsigned long long)(ab >> 20),
+                      (unsigned long long)(bb ? ab * 100 / bb : 0), (unsigned long long)(p.unusedRangeSizeMax >> 20),
+                      p.unusedRangeCount);
+    }
+    VmaTotalStatistics t{};
+    vmaCalculateStatistics(vma, &t);
+    for (uint32_t i = 0; i < dev.memory.memoryTypeCount && n < 1400; i++) {
+        const VmaDetailedStatistics& d = t.memoryType[i];
+        if (!d.statistics.blockCount) continue;
+        n += snprintf(line + n, sizeof line - n, " t%u %u blocks %llu MiB, used %llu MiB, largest hole %llu MiB;", i,
+                      d.statistics.blockCount, (unsigned long long)(d.statistics.blockBytes >> 20),
+                      (unsigned long long)(d.statistics.allocationBytes >> 20), (unsigned long long)(d.unusedRangeSizeMax >> 20));
+    }
+    logf("%s", line);
