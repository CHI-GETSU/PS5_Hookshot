+/* PS5: (measure) the VkDeviceMemory an allocation lies in (its block, or its own) and its size */
+bool vma_memory_of(VmaAllocation a, uint64_t* memory, uint64_t* size) {
+    if (!vma || !a) return false;
+    VmaAllocationInfo info{};
+    vmaGetAllocationInfo(vma, a, &info);
+    *memory = (uint64_t)(uintptr_t)info.deviceMemory, *size = info.size;
+    return info.deviceMemory != VK_NULL_HANDLE;
+}
