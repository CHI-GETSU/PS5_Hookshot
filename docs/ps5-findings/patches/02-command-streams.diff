+/* PS5: see vk_internal.h. The same buffer create_buffer(host_visible = true) makes, in a vkAllocateMemory of its own */
+bool create_buffer_dedicated(uint64_t size, VkBufferUsageFlags usage, VkBuffer& buffer, VmaAllocation& allocation,
+                             void** mapped, uint32_t* memory_type) {
+    VkBufferCreateInfo bi{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+    bi.size = size;
+    bi.usage = usage;
+    VmaAllocationCreateInfo ai{};
+    ai.usage = VMA_MEMORY_USAGE_AUTO;
+    ai.flags = VMA_ALLOCATION_CREATE_HOST_ACCESS_SEQUENTIAL_WRITE_BIT | VMA_ALLOCATION_CREATE_MAPPED_BIT |
+               VMA_ALLOCATION_CREATE_DEDICATED_MEMORY_BIT;
+    VmaAllocationInfo info{};
+    if (vmaCreateBuffer(vma, &bi, &ai, &buffer, &allocation, &info) != VK_SUCCESS) return false;
+    if (mapped) *mapped = info.pMappedData;
+    if (memory_type) *memory_type = info.memoryType;
+    return true;
+}
