+/* PS5 port (heap pieces): the piece size (0: one block per segment, as before), rounded to the heap's unit.
+ * Called once at start, before the threads that allocate; under the lock all the same. */
+void
+ps5p_heap_set_piece(size_t bytes)
+{
+   pthread_mutex_lock(&segment_lock);
+   heap_piece_bytes = bytes ? ps5p_round_up(bytes, HEAP_UNIT) : 0;
+   pthread_mutex_unlock(&segment_lock);
+}
+
+/* PS5 port (heap pieces): the piece size, the refusals so far and the last one (what was asked, what had been
+ * got). A report, read without the lock. */
+void
+ps5p_heap_refusal(size_t *piece, unsigned long long *count, size_t *asked, size_t *got)
+{
+   *piece = heap_piece_bytes;
+   *count = refusals;
+   *asked = refused_bytes;
+   *got = refused_got;
+}
+
+/* PS5 port (operator new wait): give back to the console what the arenas hold free at their tops (dlmalloc's
+ * mspace_trim, each arena under its own lock; the segments go back through ps5p_heap_unmap under segment_lock, the
+ * order every return already takes). Only arenas made so far. Returns the heap's mapped bytes before minus after
+ * (other threads' maps and returns in the meantime count too: a figure for the log, not a decision). Called by
+ * operator new while it waits and, with HOS_HEAP_GAP=1, by the title every 10 s. */
+int mspace_trim(mspace space, size_t pad);
+size_t
+ps5p_heap_trim(void)
+{
+   /* (mapped_bytes is written under segment_lock: read under it too; never held across mspace_trim, which takes it) */
+   pthread_mutex_lock(&segment_lock);
+   const size_t before = mapped_bytes;
+   pthread_mutex_unlock(&segment_lock);
+   for (unsigned i = 0; i < HEAP_ARENAS; i++)
+      if (__atomic_load_n(&arena_states[i], __ATOMIC_ACQUIRE) == 2)
+         mspace_trim(arenas[i], 0);
+   pthread_mutex_lock(&segment_lock);
+   const size_t after = mapped_bytes;
+   pthread_mutex_unlock(&segment_lock);
+   return before > after ? before - after : 0;   /* (other threads' maps and returns meanwhile count too: a figure) */
+}
+
+/* PS5 port (heap gap): the switches, called once at start before the threads that allocate. */
+void
+ps5p_heap_set_gap(bool on)
+{
+   pthread_mutex_lock(&segment_lock);
+   heap_gap_bytes = on ? HEAP_UNIT : 0;
+   pthread_mutex_unlock(&segment_lock);
+}
+
+void
+ps5p_heap_set_count(bool on)
+{
+   __atomic_store_n(&heap_count, on, __ATOMIC_RELAXED);
+}
+
+long long
+ps5p_heap_in_use(void)
+{
+   return __atomic_load_n(&heap_in_use, __ATOMIC_RELAXED);
+}
+
+static inline void
+count_block(const void *pointer, int sign)
+{
+   if (pointer && __atomic_load_n(&heap_count, __ATOMIC_RELAXED))
+      __atomic_fetch_add(&heap_in_use, sign * (long long)mspace_usable_size(pointer), __ATOMIC_RELAXED);
+}
