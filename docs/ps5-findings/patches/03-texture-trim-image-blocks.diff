+/* PS5: (2026-11-10) the decisions behind three boot.ini switches, kept apart so a PC test can check them in both
+ * positions (a PC unit test). Every switch's absent or 0 value is the behaviour before these patches. */
+#pragma once
+#include <cstdint>
+#include <cstdlib>
+#include <algorithm>
+#include <tuple>
+#include <utility>
+#include <vector>
+
+/* RX_VK_RETIRED_GIVE_BACK=1: a retired pool's import is given back once the GPU is past it (Hookshot f2203e4, which had it
+   on by default with RX_VK_KEEP_RETIRED=1 to keep). Absent or 0: kept, as before. */
+inline bool ps5_retired_give_back(const char* e) { return e && atoi(e) != 0; }
+
+/* RX_VK_IMAGE_BLOCK_MB=<n>: the image pool's block size, 8 to 512 MB. Absent, 0 or out of range: 128, as before. */
+inline uint64_t ps5_image_block_bytes(const char* e) {
+    const int mb = e ? atoi(e) : 0;
+    return (uint64_t)(mb >= 8 && mb <= 512 ? mb : 128) << 20;
+}
+
+/* RX_VK_TEX_TRIM_MB=<n>: a compressed (BC or ASTC), non-depth, single-sample texture with mip levels whose bytes from its
+   current top level are over n MB leaves out top levels until it is not (the mechanism RX_VK_TEX_MAX_MB already uses for
+   huge ones; one level at least is kept). Absent or 0: nothing more left out, as before. bytes_from(skip) is the texture's
+   size from level skip down. Returns the new skip. */
+template <typename BytesFrom>
+inline uint32_t ps5_tex_trim_skip(const char* e, bool eligible, uint32_t skip, uint32_t levels, BytesFrom&& bytes_from) {
+    const uint64_t trim = (uint64_t)(e ? std::max(0, atoi(e)) : 0) << 20;
+    if (!trim || !eligible) return skip;
+    while (skip + 1 < levels && bytes_from(skip) > trim) skip++;
+    return skip;
+}
+
+/* PS5: (2026-11-11) RX_VK_IMAGE_DEDICATED_MB=<n>, 1 to 1024: an image whose memory requirement is n MB or more
+   gets a VkDeviceMemory of its own (VMA dedicated), outside the image pool, so destroying it gives its direct memory back
+   at once instead of leaving a hole in a pool block. Absent, 0 or out of range: 0, every image as before. */
+inline uint64_t ps5_image_dedicated_bytes(const char* e) {
+    const int mb = e ? atoi(e) : 0;
+    return mb >= 1 && mb <= 1024 ? (uint64_t)mb << 20 : 0;
+}
+inline bool ps5_image_goes_dedicated(uint64_t threshold, uint64_t size) { return threshold && size >= threshold; }
+
+/* PS5: (2026-11-11) RX_VK_EVICT_KEEP_RENDERED=1: the cache never evicts a texture whose texels exist only in its
+   image: written by the GPU, not finalized by the game since, and not drawn over by another image. Such a texture made
+   again reads its storage, which the GPU rendered and the CPU never wrote: it came back empty (test forêt 3, #1400
+   260x260 NVN 0xd "made again 17 frames after its eviction, sampled EMPTY"). Absent or 0: as before (the age rule). */
+inline bool ps5_keep_rendered(const char* e) { return e && atoi(e) != 0; }
+inline bool ps5_rendered_protected(bool on, bool gpu_written, bool released, bool overwritten) {
+    return on && gpu_written && !released && !overwritten;
+}
+
+/* PS5: (measure) a texture the game finalized and has not used since: what freeing finalized textures could
+   give. finalized_frame 0: never finalized. */
+inline bool ps5_finalize_candidate(uint64_t finalized_frame, uint64_t last_frame) {
+    return finalized_frame && last_frame <= finalized_frame;
+}
+/* The memory blocks the candidates would empty: per block (its id), the bytes of all live textures in it and of the
+   candidates. A block wholly of candidates would be given back whole. */
+struct Ps5BlockTally { uint64_t blocks = 0, whole = 0, whole_bytes = 0, cand_bytes = 0, cand_n = 0; };
+template <typename It>   /* It: (block id, bytes, candidate) */
+inline Ps5BlockTally ps5_block_tally(It first, It last) {
+    struct B { uint64_t all = 0, cand = 0; };
+    std::vector<std::pair<uint64_t, B>> v;
+    for (It i = first; i != last; ++i) {
+        const auto& [id, bytes, cand] = *i;
+        auto f = std::find_if(v.begin(), v.end(), [&](const auto& p) { return p.first == id; });
+        if (f == v.end()) { v.push_back({id, {}}); f = v.end() - 1; }
+        f->second.all += bytes;
+        if (cand) f->second.cand += bytes;
+    }
+    Ps5BlockTally t;
+    for (It i = first; i != last; ++i) if (std::get<2>(*i)) t.cand_bytes += std::get<1>(*i), t.cand_n++;
+    for (const auto& [id, b] : v) {
+        t.blocks++;
+        if (b.cand && b.cand == b.all) t.whole++, t.whole_bytes += b.all;
+    }
+    return t;
+}
